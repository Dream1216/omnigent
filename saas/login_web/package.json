    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.12.0",
    "next": "16.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "postcss": "8.5.23",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2"
  }
