{
  "name": "@omnigent/login-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --port 18764",
    "build": "next build --webpack && node scripts/package-export.mjs",
