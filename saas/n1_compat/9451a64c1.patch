diff --git a/deploy/docker/Dockerfile b/deploy/docker/Dockerfile
index 041e82bb0..43dc45465 100644
--- a/deploy/docker/Dockerfile
+++ b/deploy/docker/Dockerfile
@@ -425,3 +425,26 @@ HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
     CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1
 
 CMD ["python", "/app/entrypoint.py"]
+
+# ── Pinned N-1 Outbox compatibility runtime ─────────────
+# This stage is part of the fixed 9451 compatibility patch. It inherits the
+# server runtime solely for its PostgreSQL-capable Python environment, removes
+# the HTTP health check, and starts only the content-blind admission launcher.
+FROM runtime AS n1-compat-runtime
+
+ARG SOURCE_REVISION
+ARG CONTROL_PLANE_SCHEMA_REVISION
+ARG N1_BASE_COMMIT
+ARG N1_CONTRACT_VERSION
+ARG N1_PATCH_SHA256
+ARG N1_PATCHED_TREE_HASH
+
+LABEL ai.omnigent.saas.n1.base-commit=${N1_BASE_COMMIT} \
+      ai.omnigent.saas.n1.patch-source-revision=${SOURCE_REVISION} \
+      ai.omnigent.saas.n1.patch-sha256=${N1_PATCH_SHA256} \
+      ai.omnigent.saas.n1.patched-tree-hash=${N1_PATCHED_TREE_HASH} \
+      ai.omnigent.saas.n1.schema-revision=${CONTROL_PLANE_SCHEMA_REVISION} \
+      ai.omnigent.saas.n1.contract-version=${N1_CONTRACT_VERSION}
+
+HEALTHCHECK NONE
+CMD ["python", "-I", "-m", "saas.n1_outbox_launcher"]
