+"""One-purpose launcher for the patched N-1 Outbox compatibility worker."""
+
+from __future__ import annotations
+
+import os
+import sys
+
+import sqlalchemy as sa
+
+from saas.n1_outbox_compat_admission import (
+    catalog_fingerprint,
+    dsn_coordinate_fingerprint,
+)
+
+_CATALOG_FINGERPRINT_ENV = "OMNIGENT_SAAS_N1_COMPAT_CATALOG_FINGERPRINT"
+_DATABASE_URL_ENV = "OMNIGENT_SAAS_CONTROL_PLANE_DATABASE_URL"
+_DSN_FINGERPRINT_ENV = "OMNIGENT_SAAS_N1_COMPAT_DSN_FINGERPRINT"
+_EXPECTED_LOGIN_ENV = "OMNIGENT_SAAS_N1_COMPAT_EXPECTED_LOGIN"
+_PYTHON_INJECTION_ENV = frozenset(
+    {
+        "PYTHONBREAKPOINT",
+        "PYTHONHOME",
+        "PYTHONINSPECT",
+        "PYTHONPATH",
+        "PYTHONSTARTUP",
+        "PYTHONWARNINGS",
+    }
+)
+
+
+def main() -> int:
+    """Admit the real Worker DSN, then atomically replace this process."""
+
+    database_url = os.environ.get(_DATABASE_URL_ENV, "").strip()
+    expected_login = os.environ.get(_EXPECTED_LOGIN_ENV, "").strip()
+    if not database_url or not expected_login:
+        raise RuntimeError("N-1 Outbox compatibility launcher configuration is invalid")
+
+    engine = None
+    try:
+        engine = sa.create_engine(database_url, pool_pre_ping=True, hide_parameters=True)
+        fingerprint = catalog_fingerprint(engine, expected_login=expected_login)
+    except Exception:  # noqa: BLE001 - never expose a credential-bearing URL
+        raise RuntimeError("N-1 Outbox compatibility launcher admission failed") from None
+    finally:
+        if engine is not None:
+            engine.dispose()
+
+    child_environment = {
+        name: value for name, value in os.environ.items() if name not in _PYTHON_INJECTION_ENV
+    }
+    child_environment[_CATALOG_FINGERPRINT_ENV] = fingerprint
+    child_environment[_DSN_FINGERPRINT_ENV] = dsn_coordinate_fingerprint(database_url)
+    os.execve(
+        sys.executable,
+        [sys.executable, "-I", "-m", "saas.outbox_worker"],
+        child_environment,
+    )
+    return 1  # pragma: no cover - successful execve never returns
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
