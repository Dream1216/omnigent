index 000000000..760b0fc06
--- /dev/null
+++ b/saas/n1_outbox_compat_admission.py
@@ -0,0 +1,712 @@
+"""Catalog-bound admission for the pinned N-1 Outbox compatibility worker."""
+
+from __future__ import annotations
+
+import json
+import re
+from hashlib import sha256
+from typing import Never
+
+import sqlalchemy as sa
+from sqlalchemy.engine import Engine
+
+_BASE_ROLE = "saas_dispatcher"
+_COMPAT_ROLE = "saas_dispatcher_n1_compat"
+_CONTRACT = "p0s3-n1-outbox-security-compat-v1"
+_LOGIN_PATTERN = re.compile(r"[a-z][a-z0-9_]{0,62}")
+_REJECTION = "N-1 Outbox compatibility catalog admission rejected"
+_SANITIZER_SOURCE_SHA256 = "06622ed237a21880bf84846f082deb876c3935597cd692f283d6f505cb616e3a"
+_DSN_FINGERPRINT_DOMAIN = b"omnigent:n1-compat:control-plane-coordinate:v1\0"
+_N1_OUTBOX_SELECT_COLUMNS = frozenset(
+    {
+        "id",
+        "published_at",
+        "available_at",
+        "claimed_at",
+        "created_at",
+        "claim_token",
+        "event_type",
+        "aggregate_type",
+        "aggregate_key",
+        "payload",
+        "attempt_count",
+    }
+)
+_N1_OUTBOX_UPDATE_COLUMNS = frozenset(
+    {
+        "attempt_count",
+        "available_at",
+        "claimed_at",
+        "claim_token",
+        "last_error",
+        "published_at",
+    }
+)
+_N1_COLUMN_ACLS = (
+    {
+        ("saas_platform_role_assignments", "expires_at", "SELECT", False),
+        ("saas_platform_role_assignments", "principal_id", "SELECT", False),
+        ("saas_platform_role_assignments", "role", "SELECT", False),
+        ("saas_platform_role_assignments", "status", "SELECT", False),
+        ("saas_platform_support_sessions", "expires_at", "SELECT", False),
+        ("saas_platform_support_sessions", "principal_id", "SELECT", False),
+        ("saas_platform_support_sessions", "revoked_at", "SELECT", False),
+        ("saas_platform_support_sessions", "token_hash", "SELECT", False),
+    }
+    | {
+        ("saas_control_plane_outbox", column, "SELECT", False)
+        for column in _N1_OUTBOX_SELECT_COLUMNS
+    }
+    | {
+        ("saas_control_plane_outbox", column, "UPDATE", False)
+        for column in _N1_OUTBOX_UPDATE_COLUMNS
+    }
+)
+_N1_EFFECTIVE_COLUMN_ACLS = {
+    (table, column, privilege) for table, column, privilege, _ in _N1_COLUMN_ACLS
+}
+_OUTBOX_SCHEMA_SIGNATURE = [
+    (1, "id", "uuid", True, None, "", ""),
+    (2, "tenant_id", "uuid", False, None, "", ""),
+    (3, "aggregate_type", "character varying(64)", True, None, "", ""),
+    (4, "aggregate_key", "character varying(256)", True, None, "", ""),
+    (5, "event_type", "character varying(128)", True, None, "", ""),
+    (6, "payload", "json", True, None, "", ""),
+    (7, "idempotency_key", "character varying(128)", True, None, "", ""),
+    (8, "request_hash", "character varying(64)", True, None, "", ""),
+    (9, "attempt_count", "integer", True, None, "", ""),
+    (10, "published_at", "timestamp with time zone", False, None, "", ""),
+    (11, "created_at", "timestamp with time zone", True, "now()", "", ""),
+    (12, "available_at", "timestamp with time zone", False, None, "", ""),
+    (13, "claimed_at", "timestamp with time zone", False, None, "", ""),
+    (14, "claim_token", "uuid", False, None, "", ""),
+    (15, "last_error", "character varying(2048)", False, None, "", ""),
+    (16, "last_error_code", "character varying(128)", False, "NULL::character varying", "", ""),
+    (17, "last_error_digest", "character varying(64)", False, "NULL::character varying", "", ""),
+    (18, "quarantined_at", "timestamp with time zone", False, None, "", ""),
+]
+
+
+def _reject() -> Never:
+    raise RuntimeError(_REJECTION) from None
+
+
+def dsn_coordinate_fingerprint(database_url: str) -> str:
+    """Bind non-secret connection coordinates without deriving from credentials."""
+
+    try:
+        url = sa.engine.make_url(database_url)
+        query = dict(url.query)
+        if not url.drivername.startswith("postgresql") or set(query) - {"sslmode"}:
+            _reject()
+        sslmode = query.get("sslmode", "")
+        if sslmode not in {
+            "",
+            "disable",
+            "allow",
+            "prefer",
+            "require",
+            "verify-ca",
+            "verify-full",
+        }:
+            _reject()
+        coordinates = {
+            "database": url.database or "",
+            "driver": url.drivername,
+            "host": url.host or "",
+            "port": url.port or 0,
+            "sslmode": sslmode,
+            "username": url.username or "",
+        }
+        encoded = json.dumps(
+            coordinates, sort_keys=True, separators=(",", ":"), ensure_ascii=True
+        ).encode()
+    except Exception:  # noqa: BLE001 - URL failures must not expose credential text
+        _reject()
+    return sha256(_DSN_FINGERPRINT_DOMAIN + encoded).hexdigest()
+
+
+def _normalized_expression(value: object) -> str:
+    return re.sub(r"[\s()]", "", str(value)).upper()
+
+
+def _membership_projection() -> str:
+    # PostgreSQL 16 introduced per-membership INHERIT/SET options.  Reading
+    # through to_jsonb keeps the query parseable on older catalogs; absence is
+    # intentionally treated as the historical permissive default.
+    return (
+        "granted.rolname, membership.admin_option, "
+        "COALESCE((to_jsonb(membership) ->> 'inherit_option')::boolean, true), "
+        "COALESCE((to_jsonb(membership) ->> 'set_option')::boolean, true) "
+    )
+
+
+def catalog_fingerprint(engine: Engine, *, expected_login: str) -> str:
+    """Return a canonical fingerprint only for the exact p0s3 compatibility ACL.
+
+    Every read is made by the worker's real connection in one read-only,
+    repeatable-read transaction.  Neither a DSN nor a catalog value is exposed
+    on rejection.  The launcher passes the result across ``execve`` and the
+    worker recomputes it before constructing the dispatcher.
+    """
+
+    if engine.dialect.name != "postgresql" or not _LOGIN_PATTERN.fullmatch(expected_login):
+        _reject()
+
+    try:
+        with engine.connect() as connection:
+            connection.exec_driver_sql(
+                "SET TRANSACTION ISOLATION LEVEL REPEATABLE READ, READ ONLY"
+            )
+            identity = connection.execute(
+                sa.text(
+                    "SELECT current_user, session_user, current_database(), "
+                    "(SELECT oid FROM pg_database WHERE datname = current_database()), "
+                    "current_schema(), current_schemas(false), "
+                    "current_setting('server_version_num'), "
+                    "has_schema_privilege(current_user, 'public', 'USAGE'), "
+                    "has_schema_privilege(current_user, 'public', 'CREATE'), "
+                    "pg_has_role(current_user, :compat, 'MEMBER'), "
+                    "pg_has_role(current_user, :compat, 'USAGE'), "
+                    "pg_has_role(current_user, :base, 'MEMBER'), "
+                    "pg_has_role(current_user, :base, 'USAGE')"
+                ),
+                {"base": _BASE_ROLE, "compat": _COMPAT_ROLE},
+            ).one()
+            role_facts = connection.execute(
+                sa.text(
+                    "SELECT rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole, "
+                    "rolreplication, rolbypassrls, rolinherit "
+                    "FROM pg_roles WHERE rolname IN (:login, :compat, :base) "
+                    "ORDER BY rolname"
+                ),
+                {
+                    "base": _BASE_ROLE,
+                    "compat": _COMPAT_ROLE,
+                    "login": expected_login,
+                },
+            ).all()
+            projection = _membership_projection()
+            outgoing_memberships = connection.execute(
+                sa.text(
+                    f"SELECT member.rolname, {projection}"
+                    "FROM pg_auth_members AS membership "
+                    "JOIN pg_roles AS member ON member.oid = membership.member "
+                    "JOIN pg_roles AS granted ON granted.oid = membership.roleid "
+                    "WHERE member.rolname IN (:login, :compat) "
+                    "ORDER BY member.rolname, granted.rolname"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).all()
+            incoming_memberships = connection.execute(
+                sa.text(
+                    f"SELECT granted.rolname, member.rolname, "
+                    f"{projection}"
+                    "FROM pg_auth_members AS membership "
+                    "JOIN pg_roles AS member ON member.oid = membership.member "
+                    "JOIN pg_roles AS granted ON granted.oid = membership.roleid "
+                    "WHERE granted.rolname IN (:login, :compat) "
+                    "ORDER BY granted.rolname, member.rolname"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).all()
+            role_settings = connection.execute(
+                sa.text(
+                    "SELECT count(*) FROM pg_db_role_setting AS setting "
+                    "JOIN pg_roles AS role ON role.oid = setting.setrole "
+                    "WHERE role.rolname IN (:login, :compat)"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).scalar_one()
+            login_authority_dependencies = connection.execute(
+                sa.text(
+                    "SELECT count(*) FROM pg_shdepend AS dependency "
+                    "JOIN pg_roles AS role ON role.oid = dependency.refobjid "
+                    "WHERE dependency.refclassid = 'pg_authid'::regclass "
+                    "AND dependency.deptype IN ('a', 'o') AND role.rolname = :login"
+                ),
+                {"login": expected_login},
+            ).scalar_one()
+            direct_relation_authority = connection.execute(
+                sa.text(
+                    "SELECT count(*) FROM pg_class AS relation "
+                    "JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace "
+                    "WHERE namespace.nspname <> 'information_schema' "
+                    "AND namespace.nspname !~ '^pg_' "
+                    "AND (EXISTS (SELECT 1 FROM pg_roles AS owner "
+                    "WHERE owner.oid = relation.relowner "
+                    "AND owner.rolname IN (:login, :compat)) OR EXISTS ("
+                    "SELECT 1 FROM aclexplode(relation.relacl) AS acl "
+                    "JOIN pg_roles AS grantee ON grantee.oid = acl.grantee "
+                    "WHERE grantee.rolname IN (:login, :compat)))"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).scalar_one()
+            direct_column_acls = connection.execute(
+                sa.text(
+                    "SELECT grantee.rolname, namespace.nspname, relation.relname, "
+                    "attribute.attname, "
+                    "acl.privilege_type, acl.is_grantable "
+                    "FROM pg_class AS relation "
+                    "JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace "
+                    "JOIN pg_attribute AS attribute ON attribute.attrelid = relation.oid "
+                    "CROSS JOIN LATERAL aclexplode(attribute.attacl) AS acl "
+                    "JOIN pg_roles AS grantee ON grantee.oid = acl.grantee "
+                    "WHERE namespace.nspname <> 'information_schema' "
+                    "AND namespace.nspname !~ '^pg_' "
+                    "AND relation.relkind IN ('r', 'p', 'v', 'm', 'f') "
+                    "AND attribute.attnum > 0 AND NOT attribute.attisdropped "
+                    "AND grantee.rolname IN (:login, :compat) "
+                    "ORDER BY grantee.rolname, relation.relname, attribute.attname, "
+                    "acl.privilege_type"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).all()
+            direct_schema_acls = connection.execute(
+                sa.text(
+                    "SELECT grantee.rolname, namespace.nspname, "
+                    "acl.privilege_type, acl.is_grantable "
+                    "FROM pg_namespace AS namespace "
+                    "CROSS JOIN LATERAL aclexplode(namespace.nspacl) AS acl "
+                    "JOIN pg_roles AS grantee ON grantee.oid = acl.grantee "
+                    "WHERE namespace.nspname <> 'information_schema' "
+                    "AND namespace.nspname !~ '^pg_' "
+                    "AND grantee.rolname IN (:login, :compat) "
+                    "ORDER BY grantee.rolname, namespace.nspname, acl.privilege_type"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).all()
+            non_system_schema_ownership = connection.execute(
+                sa.text(
+                    "SELECT count(*) FROM pg_namespace AS namespace "
+                    "JOIN pg_roles AS owner ON owner.oid = namespace.nspowner "
+                    "WHERE namespace.nspname <> 'information_schema' "
+                    "AND namespace.nspname !~ '^pg_' "
+                    "AND owner.rolname IN (:login, :compat)"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).scalar_one()
+            direct_catalog_authority = connection.execute(
+                sa.text(
+                    "SELECT ("
+                    "SELECT count(*) FROM pg_proc AS object "
+                    "WHERE EXISTS (SELECT 1 FROM pg_roles AS owner "
+                    "WHERE owner.oid = object.proowner "
+                    "AND owner.rolname IN (:login, :compat)) OR EXISTS ("
+                    "SELECT 1 FROM aclexplode(object.proacl) AS acl "
+                    "JOIN pg_roles AS grantee ON grantee.oid = acl.grantee "
+                    "WHERE grantee.rolname IN (:login, :compat))) + ("
+                    "SELECT count(*) FROM pg_type AS object "
+                    "WHERE EXISTS (SELECT 1 FROM pg_roles AS owner "
+                    "WHERE owner.oid = object.typowner "
+                    "AND owner.rolname IN (:login, :compat)) OR EXISTS ("
+                    "SELECT 1 FROM aclexplode(object.typacl) AS acl "
+                    "JOIN pg_roles AS grantee ON grantee.oid = acl.grantee "
+                    "WHERE grantee.rolname IN (:login, :compat))) + ("
+                    "SELECT count(*) FROM pg_database AS object "
+                    "WHERE EXISTS (SELECT 1 FROM pg_roles AS owner "
+                    "WHERE owner.oid = object.datdba "
+                    "AND owner.rolname IN (:login, :compat)) OR EXISTS ("
+                    "SELECT 1 FROM aclexplode(object.datacl) AS acl "
+                    "JOIN pg_roles AS grantee ON grantee.oid = acl.grantee "
+                    "WHERE grantee.rolname IN (:login, :compat))) + ("
+                    "SELECT count(*) FROM pg_default_acl AS object "
+                    "WHERE EXISTS (SELECT 1 FROM pg_roles AS owner "
+                    "WHERE owner.oid = object.defaclrole "
+                    "AND owner.rolname IN (:login, :compat)) OR EXISTS ("
+                    "SELECT 1 FROM aclexplode(object.defaclacl) AS acl "
+                    "JOIN pg_roles AS grantee ON grantee.oid = acl.grantee "
+                    "WHERE grantee.rolname IN (:login, :compat)))"
+                ),
+                {"compat": _COMPAT_ROLE, "login": expected_login},
+            ).scalar_one()
+            executable_security_definers = connection.execute(
+                sa.text(
+                    "SELECT count(*) FROM pg_proc AS routine "
+                    "JOIN pg_namespace AS namespace "
+                    "ON namespace.oid = routine.pronamespace "
+                    "WHERE namespace.nspname <> 'information_schema' "
+                    "AND namespace.nspname !~ '^pg_' "
+                    "AND routine.prosecdef "
+                    "AND has_schema_privilege(current_user, namespace.oid, 'USAGE') "
+                    "AND has_function_privilege(current_user, routine.oid, 'EXECUTE')"
+                )
+            ).scalar_one()
+            effective_database_temp = connection.execute(
+                sa.text("SELECT has_database_privilege(current_user, current_database(), 'TEMP')")
+            ).scalar_one()
+            outbox_schema_columns = connection.execute(
+                sa.text(
+                    "SELECT attribute.attnum, attribute.attname, "
+                    "format_type(attribute.atttypid, attribute.atttypmod), "
+                    "attribute.attnotnull, "
+                    "pg_get_expr(default_value.adbin, default_value.adrelid), "
+                    "attribute.attidentity, attribute.attgenerated "
+                    "FROM pg_attribute AS attribute "
+                    "LEFT JOIN pg_attrdef AS default_value "
+                    "ON default_value.adrelid = attribute.attrelid "
+                    "AND default_value.adnum = attribute.attnum "
+                    "WHERE attribute.attrelid = "
+                    "'public.saas_control_plane_outbox'::regclass "
+                    "AND attribute.attnum > 0 AND NOT attribute.attisdropped "
+                    "ORDER BY attribute.attnum"
+                )
+            ).all()
+            effective_allowed_column_acls = connection.execute(
+                sa.text(
+                    "SELECT relation.relname, attribute.attname, "
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'SELECT'), "
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'INSERT'), "
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'UPDATE'), "
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'REFERENCES') "
+                    "FROM pg_class AS relation "
+                    "JOIN pg_namespace AS namespace "
+                    "ON namespace.oid = relation.relnamespace "
+                    "JOIN pg_attribute AS attribute "
+                    "ON attribute.attrelid = relation.oid "
+                    "WHERE namespace.nspname = 'public' "
+                    "AND relation.relkind IN ('r', 'p') "
+                    "AND relation.relname IN "
+                    "('saas_control_plane_outbox', "
+                    "'saas_platform_role_assignments', "
+                    "'saas_platform_support_sessions') "
+                    "AND attribute.attnum > 0 AND NOT attribute.attisdropped "
+                    "ORDER BY relation.relname, attribute.attnum"
+                )
+            ).all()
+            effective_outbox_acl = connection.execute(
+                sa.text(
+                    "SELECT has_table_privilege(current_user, "
+                    "'public.saas_control_plane_outbox', 'SELECT'), "
+                    "has_table_privilege(current_user, "
+                    "'public.saas_control_plane_outbox', 'UPDATE'), "
+                    "has_table_privilege(current_user, "
+                    "'public.saas_control_plane_outbox', 'INSERT'), "
+                    "has_table_privilege(current_user, "
+                    "'public.saas_control_plane_outbox', 'DELETE'), "
+                    "has_table_privilege(current_user, "
+                    "'public.saas_control_plane_outbox', 'TRUNCATE'), "
+                    "has_table_privilege(current_user, "
+                    "'public.saas_control_plane_outbox', 'REFERENCES'), "
+                    "has_table_privilege(current_user, "
+                    "'public.saas_control_plane_outbox', 'TRIGGER')"
+                )
+            ).one()
+            forbidden_relation_acl = connection.execute(
+                sa.text(
+                    "SELECT count(*) FROM pg_class AS relation "
+                    "JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace "
+                    "WHERE namespace.nspname = 'public' "
+                    "AND relation.relname NOT IN "
+                    "('saas_control_plane_outbox', "
+                    "'saas_platform_role_assignments', "
+                    "'saas_platform_support_sessions') AND (("
+                    "relation.relkind IN ('r', 'p', 'v', 'm', 'f') AND ("
+                    "has_table_privilege(current_user, relation.oid, 'SELECT') OR "
+                    "has_table_privilege(current_user, relation.oid, 'INSERT') OR "
+                    "has_table_privilege(current_user, relation.oid, 'UPDATE') OR "
+                    "has_table_privilege(current_user, relation.oid, 'DELETE') OR "
+                    "has_table_privilege(current_user, relation.oid, 'TRUNCATE') OR "
+                    "has_table_privilege(current_user, relation.oid, 'REFERENCES') OR "
+                    "has_table_privilege(current_user, relation.oid, 'TRIGGER'))) OR ("
+                    "relation.relkind = 'S' AND ("
+                    "has_sequence_privilege(current_user, relation.oid, 'USAGE') OR "
+                    "has_sequence_privilege(current_user, relation.oid, 'SELECT') OR "
+                    "has_sequence_privilege(current_user, relation.oid, 'UPDATE'))))"
+                )
+            ).scalar_one()
+            forbidden_column_acl = connection.execute(
+                sa.text(
+                    "SELECT count(*) FROM pg_class AS relation "
+                    "JOIN pg_namespace AS namespace "
+                    "ON namespace.oid = relation.relnamespace "
+                    "JOIN pg_attribute AS attribute "
+                    "ON attribute.attrelid = relation.oid "
+                    "WHERE namespace.nspname = 'public' "
+                    "AND relation.relkind IN ('r', 'p', 'v', 'm', 'f') "
+                    "AND relation.relname NOT IN "
+                    "('saas_control_plane_outbox', "
+                    "'saas_platform_role_assignments', "
+                    "'saas_platform_support_sessions') "
+                    "AND attribute.attnum > 0 AND NOT attribute.attisdropped AND ("
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'SELECT') OR "
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'INSERT') OR "
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'UPDATE') OR "
+                    "has_column_privilege(current_user, relation.oid, "
+                    "attribute.attname, 'REFERENCES'))"
+                )
