+package object
+
+import (
+	"strings"
+	"time"
+)
+
+func IsVerifiedEmailRecoveryContact(user *User, dest string) bool {
+	return user != nil && user.EmailVerified && user.Email != "" && strings.EqualFold(user.Email, dest)
+}
+
+func IsEmailPasswordRecoveryProofValid(user *User, email interface{}, deadline interface{}, now time.Time) bool {
+	dest, ok := email.(string)
+	if !ok || !IsVerifiedEmailRecoveryContact(user, dest) {
+		return false
+	}
+	encoded, ok := deadline.(string)
+	if !ok {
+		return false
+	}
+	expires, err := time.Parse(time.RFC3339, encoded)
+	return err == nil && now.Before(expires) && !expires.After(now.Add(5*time.Minute))
+}
