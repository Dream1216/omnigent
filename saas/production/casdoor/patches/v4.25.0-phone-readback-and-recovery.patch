+func TestStbzPhoneReadbackUsesOnlyPersistedCanonicalProof(t *testing.T) {
+	var user User
+	if err := json.Unmarshal([]byte(`{"phone":"2025550100","countryCode":"US","phoneVerified":true,"phoneE164":"+12025550100"}`), &user); err != nil {
+		t.Fatal(err)
+	}
+	masked, err := GetMaskedUser(&user, true)
+	if err != nil || masked.PhoneVerified || masked.PhoneE164 != "" {
+		t.Fatal("readback trusted posted metadata")
+	}
+	user.MarkPhoneVerified()
+	user.preparePhoneProofInsert()
+	masked, err = GetMaskedUser(&user, true)
+	if err != nil || !masked.PhoneVerified || masked.PhoneE164 != "+12025550100" {
+		t.Fatal("readback lost canonical proof")
+	}
+	user.Phone = "2025550101"
+	masked, err = GetMaskedUser(&user, true)
+	if err != nil || masked.PhoneVerified || masked.PhoneE164 != "" {
+		t.Fatal("readback retained mismatched proof")
+	}
+}
+
+func TestStbzPasswordRecoveryRequiresFreshCurrentlyVerifiedEmail(t *testing.T) {
+	now := time.Date(2026, 11, 2, 0, 0, 0, 0, time.UTC)
+	user := &User{Email: "owned@example.test", EmailVerified: true}
+	valid := now.Add(5 * time.Minute).Format(time.RFC3339)
+	if !IsEmailPasswordRecoveryProofValid(user, "OWNED@example.test", valid, now) {
+		t.Fatal("valid email proof rejected")
+	}
+	cases := []struct {
+		email    interface{}
+		deadline interface{}
+	}{
+		{nil, nil}, {"+12025550100", valid}, {"other@example.test", valid},
+		{user.Email, now.Format(time.RFC3339)}, {user.Email, now.Add(6 * time.Minute).Format(time.RFC3339)},
+		{user.Email, 123}, {123, valid}, {user.Email, "invalid"},
+	}
+	for _, item := range cases {
+		if IsEmailPasswordRecoveryProofValid(user, item.email, item.deadline, now) {
+			t.Fatal("invalid recovery proof accepted")
+		}
+	}
+	user.EmailVerified = false
+	if IsEmailPasswordRecoveryProofValid(user, user.Email, valid, now) {
+		t.Fatal("unverified email recovered account")
+	}
+	if IsVerifiedEmailRecoveryContact(&User{Phone: "2025550100", CountryCode: "US"}, "2025550100") {
+		t.Fatal("recycled phone authorized recovery")
+	}
+}
