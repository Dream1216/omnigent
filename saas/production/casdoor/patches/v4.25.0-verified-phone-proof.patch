+package object
+
+import (
+	"github.com/casdoor/casdoor/util"
+	"strings"
+)
+
+// MarkPhoneVerified is called only after this exact number passed the native OTP check.
+func (user *User) MarkPhoneVerified() {
+	number, ok := util.GetE164Number(user.Phone, user.CountryCode)
+	user.VerifiedPhone = ""
+	user.phoneProofPending = ok
+	if ok {
+		user.VerifiedPhone = number
+	}
+}
+
+func (user *User) HasVerifiedPhone() bool {
+	number, ok := util.GetE164Number(user.Phone, user.CountryCode)
+	return ok && number != "" && user.VerifiedPhone == number
+}
+
+func (user *User) preparePhoneProofInsert() {
+	if !user.phoneProofPending || !user.HasVerifiedPhone() {
+		user.VerifiedPhone = ""
+	}
+	user.phoneProofPending = false
+	user.PhoneVerified = user.HasVerifiedPhone()
+}
+
+func writesPhoneProofColumn(columns []string, name string) bool {
+	if columns == nil {
+		return true
+	}
+	for _, column := range columns {
+		if strings.EqualFold(strings.ReplaceAll(column, "_", ""), name) {
+			return true
+		}
+	}
+	return false
+}
+
+// Bind proof to the effective number; ordinary metadata cannot grant or revive it.
+func (user *User) preparePhoneProofUpdate(old *User, columns []string) {
+	phone, country := old.Phone, old.CountryCode
+	if writesPhoneProofColumn(columns, "phone") {
+		phone = user.Phone
+	}
+	if writesPhoneProofColumn(columns, "countrycode") {
+		country = user.CountryCode
+	}
+	number, ok := util.GetE164Number(phone, country)
+	trusted := user.phoneProofPending && user.HasVerifiedPhone() && ok && user.VerifiedPhone == number
+	if !trusted {
+		user.VerifiedPhone = ""
+		if ok && old.HasVerifiedPhone() && number == old.VerifiedPhone {
+			user.VerifiedPhone = old.VerifiedPhone
+		}
+	}
+	user.phoneProofPending = false
+	user.PhoneVerified = user.HasVerifiedPhone()
+}
