+func TestStbzPhoneProofNeedsTrustedOTPAndExactNumber(t *testing.T) {
+	user := &User{Phone: "2025550100", CountryCode: "US"}
+	claims := func() ClaimsStandard { return getStandardClaims(Claims{User: user, Scope: "openid phone"}) }
+	if claims().PhoneNumberVerified {
+		t.Fatal("phone presence granted verification")
+	}
+	user.MarkPhoneVerified()
+	user.preparePhoneProofInsert()
+	if !claims().PhoneNumberVerified || claims().PhoneNumber != "+12025550100" {
+		t.Fatal("OTP proof lost")
+	}
+	user.Phone = "2025550101"
+	if claims().PhoneNumberVerified {
+		t.Fatal("proof applied to a different phone")
+	}
+	user.Phone = "invalid"
+	if claims().PhoneNumberVerified {
+		t.Fatal("invalid number retained proof")
+	}
+}
+
+func TestStbzPhoneProofMetadataCannotForgeAndChangeCannotRevive(t *testing.T) {
+	var forged User
+	err := json.Unmarshal([]byte(`{"phone":"2025550100","countryCode":"US","verifiedPhone":"+12025550100","phoneVerified":true,"phoneProofPending":true}`), &forged)
+	if err != nil {
+		t.Fatal(err)
+	}
+	forged.preparePhoneProofInsert()
+	if forged.HasVerifiedPhone() {
+		t.Fatal("JSON metadata forged phone ownership")
+	}
+	old := &User{Phone: "2025550100", CountryCode: "US"}
+	old.MarkPhoneVerified()
+	old.preparePhoneProofInsert()
+	changed := &User{Phone: "2025550101", CountryCode: "US"}
+	changed.preparePhoneProofUpdate(old, []string{"Phone", "CountryCode"})
+	if changed.HasVerifiedPhone() || changed.VerifiedPhone != "" {
+		t.Fatal("phone change retained proof")
+	}
+	restored := &User{Phone: old.Phone, CountryCode: old.CountryCode}
+	restored.preparePhoneProofUpdate(changed, nil)
+	if restored.HasVerifiedPhone() {
+		t.Fatal("unverified edit revived old proof")
+	}
+	same := &User{DisplayName: "updated"}
+	same.preparePhoneProofUpdate(old, []string{"display_name"})
+	if same.VerifiedPhone != old.VerifiedPhone {
+		t.Fatal("unrelated update dropped stored proof")
+	}
+	changed.MarkPhoneVerified()
+	changed.preparePhoneProofUpdate(old, []string{"phone", "country_code"})
+	if !changed.HasVerifiedPhone() {
+		t.Fatal("fresh OTP could not verify changed phone")
+	}
+}
+
+func TestStbzPhoneProofSurvivesDatabaseButNotJSONImport(t *testing.T) {
+	engine, err := xorm.NewEngine("sqlite", filepath.Join(t.TempDir(), "proof.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer engine.Close()
+	if _, err := engine.Exec(`CREATE TABLE user (owner VARCHAR(100) NOT NULL, name VARCHAR(100) NOT NULL, id VARCHAR(100), phone VARCHAR(100), country_code VARCHAR(6), PRIMARY KEY (owner,name))`); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := engine.Exec(`INSERT INTO user (owner,name,id,phone,country_code) VALUES ('owned','legacy','legacy-id','2025550101','US')`); err != nil {
+		t.Fatal(err)
+	}
+	if err := engine.Sync2(&User{}); err != nil {
+		t.Fatal(err)
+	}
+	var legacy User
+	if found, err := engine.Where("owner = ? AND name = ?", "owned", "legacy").Get(&legacy); err != nil || !found || legacy.HasVerifiedPhone() {
+		t.Fatal("schema migration inferred legacy ownership")
+	}
+	if _, err := SetUserField(&legacy, "Verified_Phone", "+12025550101"); err == nil {
+		t.Fatal("generic field write accepted proof")
+	}
+	user := &User{Owner: "owned", Name: "phone", Id: "stable-id", Phone: "2025550100", CountryCode: "US"}
+	user.MarkPhoneVerified()
+	user.preparePhoneProofInsert()
+	if _, err := engine.Insert(user); err != nil {
+		t.Fatal(err)
+	}
+	var read User
+	found, err := engine.Where("owner = ? AND name = ?", user.Owner, user.Name).Get(&read)
+	if err != nil || !found || !read.HasVerifiedPhone() {
+		t.Fatalf("persisted proof lost: %v", err)
+	}
+	masked, err := GetMaskedUser(&read, true)
+	if err != nil || !masked.PhoneVerified {
+		t.Fatal("readback omitted verification fact")
+	}
+	encoded, err := json.Marshal(masked)
+	if err != nil || strings.Contains(string(encoded), "verifiedPhone") {
+		t.Fatal("internal proof leaked in JSON")
+	}
+	var imported User
+	if err := json.Unmarshal(encoded, &imported); err != nil {
+		t.Fatal(err)
+	}
+	imported.preparePhoneProofInsert()
+	if imported.HasVerifiedPhone() {
+		t.Fatal("metadata import inherited ownership proof")
+	}
+}
