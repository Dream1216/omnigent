+func TestStbzCombinedSignupContactRequired(t *testing.T) {
+	for _, name := range []string{"Email or Phone", "Phone or Email"} {
+		application := &Application{SignupItems: []*SignupItem{{Name: name, Visible: true, Required: true}}}
+		for _, authForm := range []*form.AuthForm{{}, {Email: " ", Phone: "\t"}} {
+			if application.HasRequiredSignupContact(authForm) {
+				t.Fatalf("%s accepted an empty required contact", name)
+			}
+		}
+		if msg := CheckUserSignup(application, &Organization{}, &form.AuthForm{}, "en"); msg == "" {
+			t.Fatalf("%s direct signup validation accepted no contact", name)
+		}
+		for _, authForm := range []*form.AuthForm{{Email: "new@example.test"}, {Phone: "2025550100"}} {
+			if !application.HasRequiredSignupContact(authForm) {
+				t.Fatalf("%s rejected a supplied contact", name)
+			}
+		}
+		application.SignupItems[0].Required = false
+		if !application.HasRequiredSignupContact(&form.AuthForm{}) {
+			t.Fatalf("%s changed optional contact behavior", name)
+		}
+		application.SignupItems[0].Required = true
+		application.SignupItems[0].Visible = false
+		if !application.HasRequiredSignupContact(&form.AuthForm{}) {
+			t.Fatalf("%s changed hidden contact behavior", name)
+		}
+	}
+}
+
+func TestStbzSignupUsernameUsesGeneratedIdForPhone(t *testing.T) {
+	organization := &Organization{UseEmailAsUsername: true}
+	for _, name := range []string{"Email or Phone", "Phone or Email", "Email", "Phone"} {
+		application := &Application{SignupItems: []*SignupItem{{Name: name, Visible: true, Required: true}}}
+		if got := application.GetSignupUsername(organization, &form.AuthForm{Phone: "2025550100"}, "generated-id"); got != "generated-id" {
+			t.Fatalf("%s used an empty email as phone account username", name)
+		}
+		if application.IsSignupFieldVisible("Email") {
+			if got := application.GetSignupUsername(organization, &form.AuthForm{Email: "new@example.test"}, "generated-id"); got != "new@example.test" {
+				t.Fatalf("%s changed email-as-username behavior", name)
+			}
+		}
+	}
+	application := &Application{SignupItems: []*SignupItem{{Name: "Email or Phone", Visible: true}, {Name: "Username", Visible: true}}}
+	if got := application.GetSignupUsername(organization, &form.AuthForm{Username: "chosen-name", Email: "new@example.test"}, "generated-id"); got != "chosen-name" {
+		t.Fatal("visible username was replaced")
+	}
+	application.SignupItems[1].Visible = false
+	organization.UseEmailAsUsername = false
+	if got := application.GetSignupUsername(organization, &form.AuthForm{Email: "new@example.test"}, "generated-id"); got != "generated-id" {
+		t.Fatal("disabled email-as-username was ignored")
+	}
+}
