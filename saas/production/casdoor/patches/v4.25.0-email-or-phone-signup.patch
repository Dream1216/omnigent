+// HasRequiredSignupContact enforces a combined address item on direct API requests.
+func (application *Application) HasRequiredSignupContact(authForm *form.AuthForm) bool {
+	for _, name := range []string{"Email or Phone", "Phone or Email"} {
+		item := application.getSignupItem(name)
+		if item != nil && item.Visible && item.Required &&
+			strings.TrimSpace(authForm.Email) == "" && strings.TrimSpace(authForm.Phone) == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// GetSignupUsername keeps phone-only accounts on their generated identifier.
+func (application *Application) GetSignupUsername(organization *Organization, authForm *form.AuthForm, id string) string {
+	if application.IsSignupItemVisible("Username") {
+		return authForm.Username
+	}
+	if organization.UseEmailAsUsername && application.IsSignupFieldVisible("Email") && authForm.Email != "" {
+		return authForm.Email
+	}
+	return id
