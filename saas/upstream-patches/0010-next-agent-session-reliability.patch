+    host_command: list[str] | None,
@@ -3373,0 +3411,2 @@
+    :param host_command: Optional reviewed child argv to run beneath the
+        launcher's PID-1 reaper instead of ``omnigent host``.
@@ -3407,0 +3447 @@
