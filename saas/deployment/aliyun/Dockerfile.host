# Candidate MicroVM Host; production admission is a separate release gate.
ARG DEBIAN_IMAGE=debian:sid-slim@sha256:10e9e0d7aa4ed47205c7053f117199e6b06a9b17ac3eeb7f7bb1a818b963a803
ARG PYTHON_IMAGE=python:3.13.18-slim@sha256:aaf08c5490d52cd92bc27142a5215b1e47355a5eaf9adfad2a0fbc022d0b5490
ARG NODE_IMAGE=node:22-slim@sha256:9f0dde62d10e7ff7a310ecaebd66225f6b46c17e6cb778449a77b05d3541bea2

FROM ${NODE_IMAGE} AS node-runtime
FROM ${PYTHON_IMAGE} AS python-runtime
FROM ${DEBIAN_IMAGE} AS debian-runtime

FROM scratch AS ossfs-material
ADD --checksum=sha256:72e864b8087d6f889c5017339c625154619f626bbc13c9afcb70403544ad9b70 \
    https://github.com/aliyun/ossfs/releases/download/v2.0.10/ossfs2_2.0.10_linux_x86_64.deb /ossfs2_2.0.10_linux_x86_64.deb

FROM debian-runtime AS runtime-os
USER root
ARG SOURCE_DATE_EPOCH
COPY saas/deployment/aliyun/debian-minimal.sources /etc/apt/sources.list.d/debian.sources
COPY --from=python-runtime /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=ossfs-material /ossfs2_2.0.10_linux_x86_64.deb /tmp/ossfs2.deb
RUN case "${SOURCE_DATE_EPOCH}" in *[!0-9]*|'') exit 2 ;; esac \
 && apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt -o APT::Update::Error-Mode=any update \
 && echo '23fab9795bb10ed4d7c39a32d04400600d1f68a151692ac1c23ec2629a243fc0  /var/lib/apt/lists/snapshot.debian.org_archive_debian_20261030T000000Z_dists_sid_InRelease' | sha256sum -c - \
 && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt upgrade -y --no-install-recommends \
 && DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::https::CaInfo=/etc/ssl/certs/ca-certificates.crt install -y --no-install-recommends \
      systemd-sysv openssh-server sudo chrony fuse3 iptables \
      bash ca-certificates curl git tmux bubblewrap procps lsof \
      libbz2-1.0 libexpat1 libffi8 libgdbm6t64 liblzma5 libncursesw6 \
      libreadline8t64 libsqlite3-0 libssl3t64 libuuid1 zlib1g libstdc++6 \
 && echo '72e864b8087d6f889c5017339c625154619f626bbc13c9afcb70403544ad9b70  /tmp/ossfs2.deb' | sha256sum -c - \
 && dpkg -i /tmp/ossfs2.deb \
 && rm -f /tmp/ossfs2.deb \
 && groupadd --gid 1000 user \
 && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash user \
 && awk -F: -v epoch="${SOURCE_DATE_EPOCH}" 'BEGIN {OFS=":"} {if ($2 !~ /^[!*]/) exit 1; $3=int(epoch/86400); print}' /etc/shadow > /etc/shadow.normalized \
 && cat /etc/shadow.normalized > /etc/shadow \
 && rm -f /etc/shadow.normalized \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
 && test -x /sbin/init \
 && test -x /usr/sbin/sshd \
 && test -x /usr/sbin/chronyd \
 && test -x /usr/sbin/iptables \
 && rm -f /etc/ssh/ssh_host_* /var/lib/systemd/random-seed \
      /var/cache/ldconfig/aux-cache \
 && : > /etc/machine-id \
 && find /var/log -type f -delete

# Retain Debian's real package identity and remove inherited OCI configuration.
FROM scratch AS runtime-base
COPY --from=runtime-os / /
COPY --from=python-runtime /usr/local/bin/python3.13 /usr/local/bin/python3.13
COPY --from=python-runtime /usr/local/lib/libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so.1.0
COPY --from=python-runtime /usr/local/lib/python3.13 /usr/local/lib/python3.13
ENV PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
RUN ln -s python3.13 /usr/local/bin/python3 \
 && ln -s python3.13 /usr/local/bin/python \
 && ln -s libpython3.13.so.1.0 /usr/local/lib/libpython3.13.so \
 && ldconfig \
 && python3 -B -I -c 'import bz2,ctypes,dbm.gnu,lzma,pyexpat,readline,sqlite3,ssl,uuid,zlib,sys;assert sys.version_info[:3]==(3,13,18)' \
 && ossfs2 --version \
 && rm -f /var/cache/ldconfig/aux-cache

FROM runtime-base AS npm-security
ARG NPM_VERSION=12.2.0
ARG NPM_INTEGRITY=sha512-ZsJjKpTnlmSXOLLXiU1xDCzC4Wlok4IwZmh/aw2KUuXytU7q6qMv/cUT7MoeSf95Slwuw/lRXYefGzGCspHPNQ==
COPY saas/scripts/materialize_npm_release.py /opt/npm-build/materialize_npm_release.py
COPY saas/supply_chain/npm-122-security-lock.json /opt/npm-build/security-lock.json
RUN python3 -B -I /opt/npm-build/materialize_npm_release.py \
      --version "${NPM_VERSION}" --integrity "${NPM_INTEGRITY}" \
      --security-lock /opt/npm-build/security-lock.json --destination /opt/npm-export

FROM runtime-base AS node-base
ARG NPM_VERSION=12.2.0
RUN rm -rf /usr/local/lib/node_modules/npm \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=npm-security /opt/npm-export/package /usr/local/lib/node_modules/npm
RUN export NODE_DISABLE_COMPILE_CACHE=1 \
 && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node -e 'require("/usr/local/lib/node_modules/npm/lib/commands/install.js")' \
 && test "$(npm --version)" = "${NPM_VERSION}" \
 && node -e 'const v=process.versions.node.split(".").map(Number);if(v[0]!==22||v[1]<22||(v[1]===22&&v[2]<2))process.exit(1)'

FROM node-base AS builder
USER root
ARG UV_VERSION=0.12.1
ARG SOURCE_REVISION
ARG SOURCE_DATE_EPOCH
ENV PYTHONDONTWRITEBYTECODE=1 \
    OMNIGENT_SKIP_WEB_UI=true \
    UV_NO_INSTALLER_METADATA=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/build-tools \
 && /opt/build-tools/bin/pip install --no-cache-dir "uv==${UV_VERSION}"
WORKDIR /build
COPY pyproject.toml setup.py uv.lock uv.toml LICENSE NOTICE ./
COPY sdks/ ./sdks/
COPY omnigent/ ./omnigent/
COPY saas/ ./saas/
COPY integrations/slack/ ./integrations/slack/
COPY examples/ ./examples/
RUN sed -i '/^\[tool\.uv\.workspace\]$/,/^$/d' pyproject.toml \
 && /opt/build-tools/bin/uv sync --frozen --package omnigent \
      --no-dev --no-default-groups --no-editable --no-cache --extra saas \
 && /opt/venv/bin/python -B -I /build/saas/scripts/bind_runtime_build_revision.py \
      --source-revision "${SOURCE_REVISION}" \
      --source-date-epoch "${SOURCE_DATE_EPOCH}" \
 && /opt/venv/bin/python -B -I /build/saas/scripts/normalize_host_cli_tree.py \
      --root /opt/venv --source-date-epoch "${SOURCE_DATE_EPOCH}"

FROM builder AS host-cli
ARG PNPM_VERSION=12.10.1
ARG SOURCE_DATE_EPOCH
WORKDIR /opt/omnigent-host-cli
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY .github/ci-deps/package.json .github/ci-deps/package.json
RUN export HOME=/tmp/omnigent-cli-state/home \
      TMPDIR=/tmp/omnigent-cli-state/tmp \
      XDG_CACHE_HOME=/tmp/omnigent-cli-state/cache \
      XDG_CONFIG_HOME=/tmp/omnigent-cli-state/config \
      XDG_DATA_HOME=/tmp/omnigent-cli-state/data \
      XDG_STATE_HOME=/tmp/omnigent-cli-state/state \
      CODEX_HOME=/tmp/omnigent-cli-state/codex \
      PI_CODING_AGENT_DIR=/tmp/omnigent-cli-state/pi \
      npm_config_cache=/tmp/omnigent-cli-state/npm-cache; \
    mkdir -p "$HOME" "$TMPDIR" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME" \
      "$XDG_DATA_HOME" "$XDG_STATE_HOME" "$CODEX_HOME" "$PI_CODING_AGENT_DIR" \
 && npm install --prefix /tmp/omnigent-cli-state/pnpm-prefix --global \
      --no-audit --no-fund --allow-scripts=pnpm "pnpm@${PNPM_VERSION}" \
 && export PATH="/tmp/omnigent-cli-state/pnpm-prefix/bin:${PATH}" \
 && test "$(pnpm --version)" = "${PNPM_VERSION}" \
 && pnpm install --frozen-lockfile --prod --filter e2e-ci-deps \
      --store-dir /tmp/omnigent-cli-state/store --package-import-method=copy \
      --network-concurrency=4 \
 && /opt/venv/bin/python -B -c 'import email.utils,json,os; from pathlib import Path; p=Path("node_modules/.modules.yaml"); d=json.loads(p.read_text()); assert isinstance(d.get("prunedAt"),str); d["prunedAt"]=email.utils.formatdate(int(os.environ["SOURCE_DATE_EPOCH"]),usegmt=True); p.write_text(json.dumps(d,ensure_ascii=False,indent=2,sort_keys=True)+"\n"); Path("node_modules/.pnpm-workspace-state-v1.json").unlink(missing_ok=True)' \
 && .github/ci-deps/node_modules/.bin/pi --version \
 && .github/ci-deps/node_modules/.bin/codex --version \
 && /opt/venv/bin/python -B -I /build/saas/scripts/normalize_host_cli_tree.py \
      --root /opt/omnigent-host-cli --source-date-epoch "${SOURCE_DATE_EPOCH}" \
 && rm -rf /tmp/omnigent-cli-state

FROM node-base AS host
USER root
ARG SOURCE_REVISION
ARG SOURCE_DATE_EPOCH
LABEL org.opencontainers.image.revision=${SOURCE_REVISION} \
      ai.omnigent.saas.qualification=candidate \
      ai.omnigent.saas.sandbox-runtime=aliyun-microvm
ENV PATH="/opt/venv/bin:/opt/omnigent-host-cli/.github/ci-deps/node_modules/.bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/user

COPY --from=builder /opt/venv /opt/venv
COPY --from=host-cli /opt/omnigent-host-cli /opt/omnigent-host-cli
RUN printf '%s\n' 'export PATH="/opt/venv/bin:/opt/omnigent-host-cli/.github/ci-deps/node_modules/.bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"' \
      > /etc/profile.d/omnigent-venv.sh \
 && test -x /bin/bash \
 && /opt/venv/bin/python -B -I -c \
      'import sys; from omnigent import _build_info; assert _build_info.COMMIT_SHA == sys.argv[1]' \
      "${SOURCE_REVISION}" \
 && node -e 'const v=process.versions.node.split(".").map(Number);if(v[0]<22||(v[0]===22&&v[1]<13))process.exit(1)' \
 && mkdir -p /tmp/omnigent-host-readiness \
 && HOME=/tmp/omnigent-host-readiness \
      CODEX_HOME=/tmp/omnigent-host-readiness/codex \
      PI_CODING_AGENT_DIR=/tmp/omnigent-host-readiness/pi \
      /opt/venv/bin/python -B -I -c 'from omnigent.onboarding.harness_install import harness_cli_installed; assert all(harness_cli_installed(x) for x in ("pi","openai"))' \
 && rm -rf /tmp/omnigent-host-readiness \
 && dpkg-query -W -f='${Package}\t${Version}\n' > /usr/local/share/omnigent-aliyun-packages.tsv

USER user
WORKDIR /home/user
CMD ["sleep", "infinity"]
